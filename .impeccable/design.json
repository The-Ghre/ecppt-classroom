      "panel3": "#16294a", "navy": "#14243f", "navy3": "#1b3055", "inset": "#081630",
      "ink": "#ffffff", "ink1": "#e6edff", "ink2": "#cdd9f5", "muted": "#9fb2d4", "muted2": "#6f83a8",
      "blue": "#004aa3", "blueBright": "#2f74d6", "blueSoft": "#6f9ce8", "blueText": "#9cc0ff", "indigo": "#3e50dd",
      "evidence": "#6f9ce8", "attacker": "#f84b4b", "valid": "#5ad0a0", "caution": "#e0b45c", "cyan": "#79e2ec", "violet": "#c8adff",
      "line": "rgba(255,255,255,.12)", "lineSoft": "rgba(255,255,255,.08)", "grid": "rgba(143,168,255,.055)",
